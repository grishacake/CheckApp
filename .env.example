# Скопируйте в .env (он в .gitignore) — `make run` подхватит его сам.

# Прокси для запросов к Google Play: http://ЛОГИН:ПАРОЛЬ@IP:ПОРТ (также https://, socks5://).
# Пусто — запросы идут напрямую.
GP_PROXY_URL=

# Хост, через который ходим к play.google.com (обход блокировки по SNI). По умолчанию www.google.com.
# Раскомментируйте с пустым значением, чтобы ходить на play.google.com напрямую.
# GP_FRONT_HOST=
