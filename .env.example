# Local development settings. Keep POSTGRES_* and DATABASE_URL consistent.
POSTGRES_DB=checkapp
POSTGRES_USER=checkapp
POSTGRES_PASSWORD=checkapp
DATABASE_URL=postgres://checkapp:checkapp@db:5432/checkapp?sslmode=disable

# Generate once: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=15m

# Card freshness for package-name requests; 0 disables cache reads.
APP_CACHE_TTL=24h
