# Local development settings. Keep POSTGRES_* and DATABASE_URL consistent.
POSTGRES_DB=checkapp
POSTGRES_USER=checkapp
POSTGRES_PASSWORD=checkapp
DATABASE_URL=postgres://checkapp:checkapp@db:5432/checkapp?sslmode=disable

# Generate once: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=2h

# Local HTTP only. Use true with HTTPS in deployment.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Card freshness for package-name requests; 0 disables cache reads.
APP_CACHE_TTL=24h

# Freshness window for local full-text search; 0 disables local search.
APP_SEARCH_TTL=168h

# Proxy for Google Play requests: http://LOGIN:PASSWORD@IP:PORT (also https://, socks5://).
# Empty — requests go directly.
GP_PROXY_URL=

# Host used to reach play.google.com (bypasses SNI blocking in Russia). Default: www.google.com.
# Uncomment with an empty value to connect to play.google.com directly.
# GP_FRONT_HOST=
